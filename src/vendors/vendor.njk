---
layout: layouts/base.njk
pagination:
  data: vendors
  size: 1
  alias: vendor
permalink: "/vendors/{{ vendor.slug }}/"
eleventyComputed:
  pageTitle: "{{ vendor.name }}"
  description: "{{ vendor.tagline }}"
---
{% import "macros.njk" as ui %}
{% set sanctions = vendor.jurisdiction_sanctions %}
<article class="wrap page profile">
  <header class="profile-head">
    <p class="kicker">
      {% if vendor.example %}
        <span class="pill pill-example">Example</span>
      {% else %}
        <span class="pill">{{ vendor.status | statusName }}</span>
      {% endif %}
      <span>{{ vendor.primary_category | categoryName }}</span>
    </p>
    <h1>{{ vendor.name }}</h1>
    <p class="lede">{{ vendor.tagline }}</p>
    <p>{{ vendor.summary }}</p>
    <dl class="meta">
      <div>
        <dt>Headquarters</dt>
        <dd>{{ vendor.headquarters.city }}, {{ vendor.headquarters.country }}</dd>
      </div>
      <div>
        <dt>Founded</dt>
        <dd>{{ vendor.founded_year }}</dd>
      </div>
      <div>
        <dt>Last reviewed</dt>
        <dd><time datetime="{{ vendor.last_reviewed }}">{{ vendor.last_reviewed | longDate }}</time></dd>
      </div>
      <div>
        <dt>Reviewed by</dt>
        <dd>{{ vendor.reviewed_by }}</dd>
      </div>
      <div>
        <dt>Website</dt>
        <dd>
          {% set siteHref = vendor.website.source | httpUrl %}
          {% if siteHref %}<a href="{{ siteHref }}">{{ vendor.website.text }}</a>{% else %}Not recorded{% endif %}
        </dd>
      </div>
    </dl>
  </header>

  <div class="score-row score-row-profile">
    {{ ui.scoreMeter(vendor.scores.business_transparency.score, "Transparency") }}
    {{ ui.scoreMeter(vendor.scores.financial_health.score, "Financial health") }}
    {{ ui.scoreMeter(vendor.scores.customer_opsec.score, "OPSEC posture") }}
  </div>

  <aside class="sanctions-indicator sanctions-{{ sanctions.risk }}" aria-label="Jurisdiction and sanctions exposure">
    <p class="flag-label">Jurisdiction and sanctions exposure</p>
    {{ ui.riskPill(sanctions.risk, "sanctions") }}
    <p>{{ sanctions.summary.text }}</p>
    <p class="claim-meta">
      {% set sanctionsHref = sanctions.summary.source | httpUrl %}
      {% if sanctionsHref %}<a href="{{ sanctionsHref }}">{{ sanctions.summary.source_label or "Source" }}</a>{% endif %}
      <a href="#sanctions">View the evidence</a>
    </p>
  </aside>

  <div class="buyer-summary">
    <p class="flag-label">Known buyers</p>
    {{ ui.sectorPills(vendor.known_customers) }}
    <p class="claim-meta"><a href="#customers">{{ vendor.known_customers | length }} public customer record{% if vendor.known_customers.length != 1 %}s{% endif %}</a></p>
  </div>

  <nav class="toc" aria-label="On this page">
    <a href="#overview">Overview</a>
    <a href="#customers">Known customers</a>
    <a href="#five-w">5W1H</a>
    <a href="#strengths">Strengths and weaknesses</a>
    <a href="#transparency">Transparency</a>
    <a href="#financial">Financial health</a>
    <a href="#press">Press</a>
    <a href="#sentiment">Social sentiment</a>
    <a href="#opsec">OPSEC risks</a>
    <a href="#sanctions">Sanctions exposure</a>
    <a href="#residency">Data residency</a>
    <a href="#certifications">Certifications</a>
    <a href="#integrations">Integrations</a>
    <a href="#legal">Legal and regulatory</a>
    <a href="#fit">Use-case fit</a>
    <a href="#sources">Sources</a>
  </nav>

  <section id="overview" class="block">
    <h2>360 company overview</h2>
    <dl class="facts">
      <div><dt>Legal name</dt><dd>{{ ui.claim(vendor.company.legal_name) }}</dd></div>
      <div><dt>Ownership</dt><dd>{{ ui.claim(vendor.company.ownership) }}</dd></div>
      <div><dt>Founded</dt><dd>{{ ui.claim(vendor.company.founded) }}</dd></div>
      <div><dt>Size</dt><dd>{{ ui.claim(vendor.company.employees) }}</dd></div>
      <div><dt>Customers</dt><dd>{{ ui.claim(vendor.company.customers) }}</dd></div>
      <div><dt>Pricing model</dt><dd>{{ ui.claim(vendor.company.pricing_model) }}</dd></div>
      <div>
        <dt>Headquarters</dt>
        <dd>
          <p class="claim-text">{{ vendor.headquarters.city }}, {{ vendor.headquarters.country }} ({{ vendor.headquarters.country_code }})</p>
          {{ ui.sourceLine(vendor.headquarters) }}
        </dd>
      </div>
    </dl>
    <h3>Products</h3>
    <ul class="stack">
      {% for product in vendor.company.products %}
        <li>
          <h4>{{ product.name }}</h4>
          {{ ui.claim(product.summary) }}
        </li>
      {% else %}
        <li><p class="empty">Not recorded.</p></li>
      {% endfor %}
    </ul>
  </section>

  <section id="customers" class="block">
    <h2>Known customers and buyers</h2>
    <p class="note">Publicly documented organizations only. People are out of scope. This is not a complete client list, and it is not evidence about individuals who work at those organizations.</p>
    {% if vendor.known_customers.length %}
      <div class="table-scroll">
        <table>
          <caption>Public customer records for {{ vendor.name }}</caption>
          <thead>
            <tr>
              <th scope="col">Customer</th>
              <th scope="col">Sector</th>
              <th scope="col">Country</th>
              <th scope="col">Evidence</th>
              <th scope="col">Date</th>
              <th scope="col">Source</th>
            </tr>
          </thead>
          <tbody>
            {% for customer in vendor.known_customers %}
              <tr>
                <th scope="row">
                  {{ customer.name }}
                  {% if customer.note %}<span class="cell-sub">{{ customer.note }}</span>{% endif %}
                </th>
                <td>{{ customer.sector | sectorName }}</td>
                <td>{{ customer.country }}</td>
                <td>{{ customer.evidence_type | evidenceName }}</td>
                <td><time datetime="{{ customer.date }}">{{ customer.date | longDate }}</time></td>
                <td>
                  {% set href = customer.source | httpUrl %}
                  {% if href %}<a href="{{ href }}">{{ customer.source_label or "Source" }}</a>{% else %}<span class="unsourced">No source</span>{% endif %}
                  {% if customer.confidence %}<span class="cell-sub">{{ customer.confidence | confidenceName }}</span>{% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="empty">No publicly documented customers are recorded.</p>
    {% endif %}
  </section>

  <section id="five-w" class="block">
    <h2>5W1H</h2>
    <div class="w-grid">
      <section><h3>Who</h3><p class="hint">Who operates it, and who it is sold to.</p>{{ ui.claim(vendor.five_w.who) }}</section>
      <section><h3>What</h3><p class="hint">What the product claims to do.</p>{{ ui.claim(vendor.five_w.what) }}</section>
      <section><h3>Where</h3><p class="hint">Headquarters, hosting, and markets.</p>{{ ui.claim(vendor.five_w.where) }}</section>
      <section><h3>When</h3><p class="hint">Founding, funding, and the review date.</p>{{ ui.claim(vendor.five_w.when) }}</section>
      <section><h3>Why</h3><p class="hint">The stated reason a buyer would use it.</p>{{ ui.claim(vendor.five_w.why) }}</section>
      <section><h3>How</h3><p class="hint">How the product is delivered. Not a collection guide.</p>{{ ui.claim(vendor.five_w.how) }}</section>
    </div>
  </section>

  <section id="strengths" class="block">
    <h2>Strengths and weaknesses</h2>
    <div class="split">
      <div>
        <h3>Strengths</h3>
        <ul class="stack">
          {% for item in vendor.strengths %}
            <li>{{ ui.claim(item) }}</li>
          {% else %}
            <li><p class="empty">Not recorded.</p></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h3>Weaknesses</h3>
        <ul class="stack">
          {% for item in vendor.weaknesses %}
            <li>{{ ui.claim(item) }}</li>
          {% else %}
            <li><p class="empty">Not recorded.</p></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <section id="transparency" class="block">
    <div class="section-head">
      <h2>Business transparency</h2>
      {{ ui.scoreMeter(vendor.scores.business_transparency.score, "Score") }}
    </div>
    {{ ui.claim(vendor.scores.business_transparency.summary) }}
    <h3>Evidence</h3>
    <ul class="stack">
      {% for item in vendor.scores.business_transparency.evidence %}
        <li>{{ ui.claim(item) }}</li>
      {% endfor %}
    </ul>
  </section>

  <section id="financial" class="block">
    <div class="section-head">
      <h2>Financial health</h2>
      {{ ui.scoreMeter(vendor.scores.financial_health.score, "Score") }}
    </div>
    {{ ui.claim(vendor.scores.financial_health.summary) }}
    <dl class="facts">
      <div><dt>Funding</dt><dd>{{ ui.claim(vendor.financial.funding) }}</dd></div>
      <div><dt>Revenue signals</dt><dd>{{ ui.claim(vendor.financial.revenue_signals) }}</dd></div>
      <div><dt>Stability</dt><dd>{{ ui.claim(vendor.financial.stability) }}</dd></div>
    </dl>
    <h3>Investors</h3>
    <ul class="stack">
      {% for investor in vendor.financial.investors %}
        <li>
          <h4>{{ investor.name }}</h4>
          {{ ui.claim(investor.detail) }}
        </li>
      {% else %}
        <li><p class="empty">No investors recorded.</p></li>
      {% endfor %}
    </ul>
    <h3>Evidence</h3>
    <ul class="stack">
      {% for item in vendor.scores.financial_health.evidence %}
        <li>{{ ui.claim(item) }}</li>
      {% endfor %}
    </ul>
  </section>

  <section id="press" class="block">
    <h2>Press</h2>
    <div class="split">
      <div>
        <h3>Positive</h3>
        {% for item in vendor.press.positive %}
          <article class="press-item">
            <p class="kicker">{{ item.outlet }} · <time datetime="{{ item.date }}">{{ item.date | longDate }}</time></p>
            <h4>{{ item.title }}</h4>
            <p>{{ item.summary }}</p>
            {{ ui.sourceLine(item) }}
          </article>
        {% else %}
          <p class="empty">None recorded.</p>
        {% endfor %}
      </div>
      <div>
        <h3>Negative</h3>
        {% for item in vendor.press.negative %}
          <article class="press-item">
            <p class="kicker">{{ item.outlet }} · <time datetime="{{ item.date }}">{{ item.date | longDate }}</time></p>
            <h4>{{ item.title }}</h4>
            <p>{{ item.summary }}</p>
            {{ ui.sourceLine(item) }}
          </article>
        {% else %}
          <p class="empty">None recorded.</p>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="sentiment" class="block">
    <h2>Social media sentiment</h2>
    <p class="kicker">Tone: {{ vendor.social_sentiment.tone | toneName }}</p>
    {{ ui.claim(vendor.social_sentiment.summary) }}
    <ul class="stack">
      {% for signal in vendor.social_sentiment.signals %}
        <li>
          <h3>{{ signal.platform }}</h3>
          {{ ui.claim(signal.observation) }}
        </li>
      {% else %}
        <li><p class="empty">Not recorded.</p></li>
      {% endfor %}
    </ul>
  </section>

  <section id="opsec" class="block">
    <div class="section-head">
      <h2>OPSEC risks for customers</h2>
      {{ ui.scoreMeter(vendor.scores.customer_opsec.score, "OPSEC posture") }}
    </div>
    <p class="note">The score rates the customer's residual risk. A higher posture score means lower residual risk. It is not a measure of product power.</p>
    {{ ui.claim(vendor.opsec.summary) }}
    <div class="factor-list">
      {% set factors = [
        ["Data retention", vendor.opsec.data_retention],
        ["Query logging", vendor.opsec.query_logging],
        ["Jurisdiction", vendor.opsec.jurisdiction],
        ["Ownership and state links", vendor.opsec.ownership_state_links],
        ["Third-party sharing", vendor.opsec.third_party_sharing]
      ] %}
      {% for factor in factors %}
        <article class="factor">
          <div class="factor-head">
            <h3>{{ factor[0] }}</h3>
            {{ ui.riskPill(factor[1].risk) }}
          </div>
          {{ ui.claim(factor[1]) }}
        </article>
      {% endfor %}
    </div>
    <h3>Evidence</h3>
    <ul class="stack">
      {% for item in vendor.scores.customer_opsec.evidence %}
        <li>{{ ui.claim(item) }}</li>
      {% endfor %}
    </ul>
  </section>

  <section id="sanctions" class="block">
    <h2>Jurisdiction and sanctions exposure</h2>
    <p class="note">Company level only. Do not add named employees, personal contact details, or individual locations. Owner, investor, and leadership ties are legal entities and roles.</p>
    <div class="sanctions-indicator sanctions-{{ sanctions.risk }}">
      {{ ui.riskPill(sanctions.risk, "sanctions") }}
      {{ ui.claim(sanctions.summary) }}
    </div>
    <p class="note">{{ taxonomy.sanctions_review.note }} Named review countries: {{ taxonomy.sanctions_review.named_countries | join(", ") }}.</p>

    <article class="factor">
      <div class="factor-head">
        <h3>Offices, R&amp;D, and legal entities</h3>
        {{ ui.riskPill(sanctions.offices_and_entities.risk) }}
      </div>
      {{ ui.claim(sanctions.offices_and_entities) }}
      <p class="claim-meta">
        {% if sanctions.offices_and_entities.countries.length %}
          Review-list presence: {{ sanctions.offices_and_entities.countries | join(", ") }}
        {% else %}
          No review-list country recorded.
        {% endif %}
      </p>
    </article>

    <article class="factor">
      <div class="factor-head">
        <h3>Owner, investor, and leadership ties</h3>
        {{ ui.riskPill(sanctions.ownership_ties.risk) }}
      </div>
      <p class="hint">Entity level. Named private individuals are out of scope.</p>
      {{ ui.claim(sanctions.ownership_ties) }}
    </article>

    <article class="factor">
      <div class="factor-head">
        <h3>Workforce location signals</h3>
        {{ ui.riskPill(sanctions.workforce_signals.risk) }}
      </div>
      <p class="hint">Aggregate headcount or region only.</p>
      {{ ui.claim(sanctions.workforce_signals) }}
    </article>

    <h3>Sanctions screening</h3>
    <div class="table-scroll">
      <table>
        <caption>Legal-entity screening recorded for this profile</caption>
        <thead>
          <tr>
            <th scope="col">Regime</th>
            <th scope="col">Result</th>
            <th scope="col">Screened</th>
            <th scope="col">What was checked</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {% for regime in taxonomy.screening_regimes %}
            {% for item in sanctions.screening %}
              {% if item.regime == regime.id %}
                <tr>
                  <th scope="row">{{ regime.name }}</th>
                  <td>{{ item.result | screeningResultName }}</td>
                  <td><time datetime="{{ item.screened_on }}">{{ item.screened_on | longDate }}</time></td>
                  <td>{{ item.text }}</td>
                  <td>
                    {% set href = item.source | httpUrl %}
                    {% if href %}<a href="{{ href }}">{{ item.source_label or "Source" }}</a>{% endif %}
                  </td>
                </tr>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section id="residency" class="block">
    <h2>Data residency and GDPR</h2>
    {{ ui.claim(vendor.data_residency.summary) }}
    <p class="claim-meta">Regions: {% if vendor.data_residency.regions.length %}{{ vendor.data_residency.regions | join(", ") }}{% else %}Not recorded{% endif %}</p>
    <dl class="facts">
      <div><dt>GDPR roles</dt><dd>{{ ui.claim(vendor.data_residency.gdpr) }}</dd></div>
      <div><dt>Data processing agreement</dt><dd>{{ ui.claim(vendor.data_residency.dpa) }}</dd></div>
    </dl>
  </section>

  <section id="certifications" class="block">
    <h2>Security certifications</h2>
    <ul class="stack">
      {% for item in vendor.certifications %}
        <li>
          <h3>{{ item.name }} <span class="pill">{{ item.status | certStatusName }}</span></h3>
          {{ ui.claim(item.detail) }}
        </li>
      {% else %}
        <li><p class="empty">Not recorded.</p></li>
      {% endfor %}
    </ul>
  </section>

  <section id="integrations" class="block">
    <h2>Integrations and API</h2>
    {{ ui.claim(vendor.integrations.summary) }}
    <h3>API</h3>
    {{ ui.claim(vendor.integrations.api) }}
    <ul class="stack">
      {% for item in vendor.integrations.items %}
        <li>
          <h3>{{ item.name }}</h3>
          {{ ui.claim(item.detail) }}
        </li>
      {% else %}
        <li><p class="empty">Not recorded.</p></li>
      {% endfor %}
    </ul>
  </section>

  <section id="legal" class="block">
    <h2>Legal and regulatory actions</h2>
    {% for item in vendor.legal %}
      <article class="press-item">
        <p class="kicker">{{ item.status | legalStatusName }} · <time datetime="{{ item.date }}">{{ item.date | longDate }}</time></p>
        <h3>{{ item.title }}</h3>
        <p>{{ item.summary }}</p>
        {{ ui.sourceLine(item) }}
      </article>
    {% else %}
      <p class="empty">Not recorded.</p>
    {% endfor %}
  </section>

  <section id="fit" class="block">
    <h2>Use-case fit</h2>
    <ul class="stack">
      {% for item in vendor.use_case_fit %}
        <li>
          <h3>{{ item.id | useCaseName }} <span class="pill pill-fit pill-fit-{{ item.fit }}">{{ item.fit | fitName }}</span></h3>
          {{ ui.claim(item.note) }}
        </li>
      {% else %}
        <li><p class="empty">Not assessed.</p></li>
      {% endfor %}
    </ul>
  </section>

  {% if vendor.reviewer_notes %}
    <section class="block" id="notes">
      <h2>Reviewer notes</h2>
      {{ ui.claim(vendor.reviewer_notes) }}
    </section>
  {% endif %}

  <section id="sources" class="block">
    <h2>Sources</h2>
    <p class="note">Collected from the source URL on each claim. Example profiles point at example.com because the underlying pages are fictional.</p>
    <ol class="source-list">
      {% for source in vendor | collectSources %}
        <li>
          <a href="{{ source.url }}">{{ source.label }}</a>
          {% if source.accessed %}<span class="cell-sub">Accessed {{ source.accessed | longDate }}</span>{% endif %}
        </li>
      {% else %}
        <li><p class="empty">No sources recorded.</p></li>
      {% endfor %}
    </ol>
  </section>
</article>
